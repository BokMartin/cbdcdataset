{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "units"],
  "properties": {
    "request_id": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "status", "statements"],
        "properties": {
          "unit_id": {"type": "string"},
          "status": {
            "enum": ["ok", "structural_blank", "source_unavailable", "skip_language"]
          },
          "statements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "block_id", "quote", "quote_en", "code1", "odr",
                "privacy_direction", "privacy_relation", "strength", "source_mode"
              ],
              "properties": {
                "block_id": {"type": "string"},
                "quote": {"type": "string"},
                "quote_en": {"type": ["string", "null"]},
                "code1": {
                  "enum": [
                    "PRIV.ANON", "PRIV.OFF", "PRIV.MIN", "PRIV.PET", "PRIV.BAL",
                    "PRIV.CB.visibility.opaque", "PRIV.CB.visibility.transparent",
                    "AML.LIMIT", "AML.MON", "AML.FATF", "AML.RISK",
                    "KYC.TIER", "KYC.IDV", "KYC.INTERMED", "TECH.DLT",
                    "TECH.TOKEN.decided_yes", "TECH.TOKEN.decided_no", "TECH.TOKEN.considered",
                    "PROG.remuneration_yes", "PROG.remuneration_no", "PROG.remuneration_considered",
                    "PROG.restriction", "PROG.generic", "PROC.pilot_learning", "LEGAL.basis",
                    "INST.mandate", "OTHER.keep", "INTEROP.domestic", "INTEROP.crossborder",
                    "CASH.relation", "ACCESS.universal", "STAB.disintermediation",
                    "OPS.resilience", "ADOPT.experience", "SYS.design"
                  ]
                },
                "odr": {"enum": ["decision", "proposal", "finding"]},
                "privacy_direction": {"enum": ["increases", "decreases", "conditional", "neutral"]},
                "privacy_relation": {
                  "enum": ["from_state", "from_intermediary", "from_counterparty", "not_applicable"]
                },
                "strength": {"type": "integer", "minimum": 1, "maximum": 3},
                "source_mode": {"enum": ["text", "render", "text_and_render"]}
              }
            }
          }
        }
      }
    }
  }
}
