{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "quote",
      "quote_en",
      "code1",
      "odr",
      "privacy_direction",
      "privacy_relation",
      "strength"
    ],
    "properties": {
      "quote": {"type": "string", "minLength": 1},
      "quote_en": {"type": "string", "minLength": 1},
      "code1": {
        "enum": [
          "NONE.irrelevant",
          "PRIV.ANON",
          "PRIV.MIN",
          "PRIV.CB.visibility.opaque",
          "PRIV.CB.visibility.transparent",
          "PRIV.OFF",
          "PRIV.PET",
          "PRIV.BAL",
          "AML.FATF",
          "AML.MON",
          "AML.LIMIT",
          "AML.RISK",
          "KYC.IDV",
          "KYC.TIER",
          "KYC.INTERMED",
          "TECH.ARCH.account",
          "TECH.ARCH.token",
          "TECH.DLT",
          "TECH.PROG"
        ]
      },
      "odr": {"enum": ["decision", "proposal"]},
      "privacy_direction": {
        "enum": ["increases", "decreases", "conditional", "neutral"]
      },
      "privacy_relation": {
        "enum": [
          "from_state",
          "from_intermediary",
          "from_counterparty",
          "not_applicable"
        ]
      },
      "strength": {"type": "integer", "minimum": 1, "maximum": 3}
    }
  }
}
